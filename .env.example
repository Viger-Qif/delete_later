# Скопируйте файл в .env. Без ключа включится полноценный офлайн-режим.
UNIKEY_API_KEY=
UNIKEY_BASE_URL=https://www.getunikey.ai/v1
DIALOG_MODEL=google/gemini-3.1-flash-lite
SMART_MODEL=deepseek/deepseek-v4-pro
DATABASE_URL=sqlite:///./soisety.db
LLM_TIMEOUT_SECONDS=45
LLM_DIALOG_TIMEOUT_SECONDS=25
LLM_SMART_TIMEOUT_SECONDS=50
LLM_TOTAL_DEADLINE_SECONDS=120
LLM_MAX_RETRIES=1
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AUTH_REQUIRED=false
AUTH_SESSION_DAYS=30
AUTH_COOKIE_NAME=negotiation_lab_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
GUEST_USER_ID=guest
ENVIRONMENT=development
ANONYMOUS_SESSION_DAYS=7
PERSIST_USER_SCENARIO_CONTEXT=false

# Keep user drafts between restarts.
DEMO_RESET_SCENARIOS=false
# Запасные модели через запятую, проверяются один раз при старте
DIALOG_MODEL_FALLBACKS=google/gemini-3.5-flash,openai/gpt-5.2-mini,anthropic/claude-4.5-haiku
SMART_MODEL_FALLBACKS=google/gemini-3.5-flash,deepseek/deepseek-v3.2,openai/gpt-5.2
